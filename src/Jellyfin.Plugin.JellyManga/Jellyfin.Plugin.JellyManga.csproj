<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="10.11.3" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.3" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="9.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="AngleSharp" Version="1.9.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" ExcludeAssets="runtime" />
    <EmbeddedResource Include="Web/**/*" />
    <EmbeddedResource Include="../../thumb.png" LogicalName="Jellyfin.Plugin.JellyManga.Web.icon.png" />
    <EmbeddedResource Include="Sources/catalog.json" />
    <EmbeddedResource Include="Sources/legacy-catalog-v0.1.0.3.json" />
  </ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="JellyManga.Tests" /></ItemGroup>
</Project>
